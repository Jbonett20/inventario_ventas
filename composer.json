{
    "name": "sistema/inventario-ventas",
    "description": "Sistema Integral de Gestión - POS, Inventario, Facturación Electrónica",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "mpdf/mpdf": "^8.0",
        "monolog/monolog": "^3.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "psalm/phar": "^5.26"
    },
    "autoload": {
        "psr-4": {
            "SIG\\": "src/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse src/ --level 6",
        "psalm": "vendor/bin/psalm --show-info=true"
    }
}
