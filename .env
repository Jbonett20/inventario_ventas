# ============================================================
# SISTEMA INTEGRAL DE GESTIÓN (SIG) - Configuración
# ============================================================

# Entorno: development | production
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/inventario_ventas

# Base de Datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventario_ventas
DB_USER=root
DB_PASS=

# Sesión
SESSION_TIMEOUT=30
SESSION_NAME=SIGSESSID

# Seguridad
CSRF_EXPIRY=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900
