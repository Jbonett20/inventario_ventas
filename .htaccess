# ============================================================
# SIG - inventario_ventas (raiz del proyecto)
# El DocumentRoot real de la aplicacion es /public/
# ============================================================

RewriteEngine On
RewriteBase /misproyectos/entorno/inventario_ventas/

# ---- Seguridad: denegar acceso directo a carpetas sensibles ----
RewriteRule ^(src|vendor|sql|app|var)/ - [F,L]
RewriteRule ^\.env - [F,L]
RewriteRule ^composer\.(json|lock)$ - [F,L]
RewriteRule ^README\.md$ - [F,L]

# ---- Raiz del proyecto -> DocumentRoot real (/public/) ----
RewriteRule ^$ public/ [R=301,L]

# ---- No reescribir nada que ya este dentro de /public/ ----
RewriteCond %{REQUEST_URI} !^/misproyectos/entorno/inventario_ventas/public/ [NC]

# ---- No reescribir archivos/carpetas reales (ej. index.html) ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# ---- Todo lo demas se sirve desde /public/ ----
RewriteRule ^(.*)$ public/$1 [L,QSA]

# Denegar listado de directorios
Options -Indexes

# Seguridad: Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
