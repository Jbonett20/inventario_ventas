RewriteEngine On
RewriteBase /misproyectos/inventario_ventas/

# Redirigir todo a /public/ menos si ya está en /public/
RewriteCond %{REQUEST_URI} !^/misproyectos/inventario_ventas/public/
RewriteRule ^(.*)$ public/$1 [L,QSA]

# Si es la raíz exacta, redirigir a public/
RewriteRule ^$ public/ [L,R=301]

# Seguridad: Denegar acceso directo a carpetas sensibles
RewriteRule ^src/ - [F,L]
RewriteRule ^vendor/ - [F,L]
RewriteRule ^sql/ - [F,L]
RewriteRule ^app/ - [F,L]
RewriteRule ^\.env - [F,L]
RewriteRule ^composer\.(json|lock) - [F,L]

# Denegar listado de directorios
Options -Indexes

# Seguridad: Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
